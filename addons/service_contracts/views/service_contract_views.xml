<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_service_contract_list" model="ir.ui.view">
        <field name="name">service.contract.list</field>
        <field name="model">service.contract</field>
        <field name="arch" type="xml">
            <tree string="Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_value"/>
                <field name="days_remaining"
                    decoration-danger="days_remaining &lt; 30 and state == 'active'"
                    decoration-muted="state != 'active'"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'active'"
                    decoration-warning="state == 'draft'"
                    decoration-danger="state == 'cancelled' or state == 'expired'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_service_contract_form" model="ir.ui.view">
        <field name="name">service.contract.form</field>
        <field name="model">service.contract</field>
        <field name="arch" type="xml">
            <form string="Service Contract">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state not in ('draft', 'active')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                        invisible="state != 'cancelled'"/>
                    <button name="action_send_expiry_reminder" string="Send Reminder" type="object"
                        invisible="state != 'active'" icon="fa-envelope"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contract Number..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="total_value"/>
                            <field name="days_remaining"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Requests">
                            <field name="request_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="state" widget="badge"/>
                                    <field name="date_open"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_service_contract_kanban" model="ir.ui.view">
        <field name="name">service.contract.kanban</field>
        <field name="model">service.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_value"/>
                <field name="days_remaining"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="partner_id"/>
                                </div>
                                <hr/>
                                <div class="d-flex justify-content-between">
                                    <span><b>Value: </b><field name="total_value"/> €</span>
                                    <span><b>Days left: </b><field name="days_remaining"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_service_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">service.contract</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>
