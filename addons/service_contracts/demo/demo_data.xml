<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contracts -->
    <record id="demo_contract_1" model="service.contract">
        <field name="name">SC-2025-001</field>
        <field name="partner_id" ref="base.res_partner_1"/>
        <field name="date_start">2025-01-01</field>
        <field name="date_end">2026-12-31</field>
        <field name="state">active</field>
        <field name="notes">Annual IT support and maintenance contract.</field>
    </record>

    <record id="demo_contract_line_1a" model="service.contract.line">
        <field name="contract_id" ref="demo_contract_1"/>
        <field name="name">IT Support (monthly)</field>
        <field name="quantity">12</field>
        <field name="price_unit">500</field>
    </record>

    <record id="demo_contract_line_1b" model="service.contract.line">
        <field name="contract_id" ref="demo_contract_1"/>
        <field name="name">Server Monitoring</field>
        <field name="quantity">12</field>
        <field name="price_unit">150</field>
    </record>

    <record id="demo_contract_line_1c" model="service.contract.line">
        <field name="contract_id" ref="demo_contract_1"/>
        <field name="name">Annual Security Audit</field>
        <field name="quantity">1</field>
        <field name="price_unit">1200</field>
    </record>

    <!-- Contract 2 - expiring soon -->
    <record id="demo_contract_2" model="service.contract">
        <field name="name">SC-2025-002</field>
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="date_start">2025-06-01</field>
        <field name="date_end">2026-05-31</field>
        <field name="state">active</field>
        <field name="notes">Web hosting and maintenance agreement.</field>
    </record>

    <record id="demo_contract_line_2a" model="service.contract.line">
        <field name="contract_id" ref="demo_contract_2"/>
        <field name="name">Web Hosting (monthly)</field>
        <field name="quantity">12</field>
        <field name="price_unit">80</field>
    </record>

    <record id="demo_contract_line_2b" model="service.contract.line">
        <field name="contract_id" ref="demo_contract_2"/>
        <field name="name">CMS Updates</field>
        <field name="quantity">4</field>
        <field name="price_unit">200</field>
    </record>

    <!-- Contract 3 - draft -->
    <record id="demo_contract_3" model="service.contract">
        <field name="name">SC-2026-001</field>
        <field name="partner_id" ref="base.res_partner_3"/>
        <field name="date_start">2026-06-01</field>
        <field name="date_end">2027-05-31</field>
        <field name="state">draft</field>
        <field name="notes">Consulting services contract — pending approval.</field>
    </record>

    <record id="demo_contract_line_3a" model="service.contract.line">
        <field name="contract_id" ref="demo_contract_3"/>
        <field name="name">Business Consulting (days)</field>
        <field name="quantity">20</field>
        <field name="price_unit">800</field>
    </record>

    <!-- Contract 4 - expired -->
    <record id="demo_contract_4" model="service.contract">
        <field name="name">SC-2024-005</field>
        <field name="partner_id" ref="base.res_partner_12"/>
        <field name="date_start">2024-01-01</field>
        <field name="date_end">2024-12-31</field>
        <field name="state">expired</field>
    </record>

    <record id="demo_contract_line_4a" model="service.contract.line">
        <field name="contract_id" ref="demo_contract_4"/>
        <field name="name">Software License</field>
        <field name="quantity">5</field>
        <field name="price_unit">300</field>
    </record>

    <!-- Service Requests -->
    <record id="demo_request_1" model="service.request">
        <field name="name">Server down — urgent intervention needed</field>
        <field name="contract_id" ref="demo_contract_1"/>
        <field name="priority">3</field>
        <field name="state">in_progress</field>
        <field name="description">Production server is not responding since 09:00. Client reports total downtime.</field>
    </record>

    <record id="demo_request_2" model="service.request">
        <field name="name">Monthly backup verification</field>
        <field name="contract_id" ref="demo_contract_1"/>
        <field name="priority">0</field>
        <field name="state">done</field>
        <field name="description">Routine check of all backup procedures and restore tests.</field>
    </record>

    <record id="demo_request_3" model="service.request">
        <field name="name">Website slow loading — performance issue</field>
        <field name="contract_id" ref="demo_contract_2"/>
        <field name="priority">2</field>
        <field name="state">new</field>
        <field name="description">Client reports homepage taking over 8 seconds to load.</field>
    </record>
</odoo>
