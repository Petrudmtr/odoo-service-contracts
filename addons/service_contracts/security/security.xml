<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_service_contracts" model="ir.module.category">
        <field name="name">Service Contracts</field>
    </record>

    <record id="group_service_contracts_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_service_contracts"/>
    </record>

    <record id="group_service_contracts_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_service_contracts"/>
        <field name="implied_ids" eval="[(4, ref('group_service_contracts_user'))]"/>
    </record>
</odoo>
